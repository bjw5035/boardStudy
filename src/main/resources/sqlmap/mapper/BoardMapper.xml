<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.study.boardStudy.dao.admin.BoardDAO">

  <!-- 게시글 삭제 -->
  <delete id="boardDelete" parameterType="int">
    DELETE
    FROM CONTENT_POST
    WHERE SEQ = '#{seq}';
  </delete>

  <select id="findOneSelect" parameterType="int" resultType="com.study.boardStudy.vo.ContentVO">
    SELECT *
    FROM CONTENT_POST
    WHERE SEQ = #{seq};
  </select>

